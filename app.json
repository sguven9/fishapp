{
  "expo": {
    "name": "Fish App",
    "slug": "fishapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fish App to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fish App to access your photos."
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyD-REPLACE_WITH_YOUR_GOOGLE_MAPS_KEY"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fishapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.fishapp.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
